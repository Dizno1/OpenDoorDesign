# Development leaves this unset and uses community/server/db/community.db.
DATABASE_PATH=

# The public URL this server is reachable at once deployed.
# Required in production.
PUBLIC_BASE_URL=https://community-api.opendoordesign.org

# Which email provider to use.
# "console" is the development default and only logs messages.
# Production currently uses "resend".
EMAIL_PROVIDER=console

# The From identity used on outgoing Community confirmation emails.
EMAIL_FROM_ADDRESS=Open Door Design Community <Collaborate@community.opendoordesign.org>

# Required when EMAIL_PROVIDER is set to a provider that needs credentials,
# such as Resend. Never store the real key in the repository.
EMAIL_PROVIDER_API_KEY=

# Community administration.
# The admin area is not mounted unless ADMIN_ENABLED=true.
# When enabled, both ADMIN_USERNAME and ADMIN_PASSWORD are required.
ADMIN_ENABLED=false
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Registration rate limiting.
# Defaults allow 20 submissions per IP address per 15-minute window.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=20
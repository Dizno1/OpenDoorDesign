# Copy this file to .env for local development, or set these as real
# environment variables in your hosting platform for production. Never commit
# an actual .env file or any real secret value — .gitignore already excludes
# .env for this reason.

# development | production. Production enforces the required variables below.
NODE_ENV=development

# Port the server listens on locally. Most hosting platforms set this for
# you automatically; only set it yourself for local development if 4001 is
# unavailable.
PORT=4001

# Path to the SQLite database file. Required in production so the value is
# deliberate rather than defaulted, since it must point at persistent
# storage (see ../docs/architecture/Community Deployment Options.md).
# Development leaves this unset and uses community/server/db/community.db.
DATABASE_PATH=

# The public URL this server is reachable at once deployed (for example
# https://community-api.opendoordesign.org). Required in production. Used
# for startup logging and will be used by future email templates that link
# back to the site.
PUBLIC_BASE_URL=

# Which email provider to use. "console" (the default) only logs the email
# it would send and never claims delivery — see ../email/README.md. Set this
# to a real provider's name once one is configured; do not hard-code a
# provider's name anywhere else in the codebase.
EMAIL_PROVIDER=console

# The "From" address used on outgoing confirmation emails.
EMAIL_FROM_ADDRESS=Accessibility@OpenDoorDesign.org

# Required only if EMAIL_PROVIDER is set to something other than "console".
# Whatever provider is chosen later, its credential belongs here, as an
# environment variable — never inside the repository.
EMAIL_PROVIDER_API_KEY=

# Registration rate limiting (Feature 003, Phase 3). Defaults allow 20
# submissions per IP address per 15-minute window; adjust for expected
# traffic once real usage data exists.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=20
